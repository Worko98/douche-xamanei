{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "douche-xamanei",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "d265a0d5-74a4-4bc9-9e6a-27dcdcc09f11","database_name": "dousheh" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "2cc68a27e7024c50aa9732b11feea442" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
